{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    "paths": {
      "#lib/model-settings": ["./lib/model-settings.ts"],
      "#lib/novel-store": ["./lib/novel-store.ts"],
      "#models/model-page-types": ["./features/models/state/model-page-types.ts"],
      "#studio/parts-builder": ["./features/studio/store/slices/message/parts-builder.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts"]
}
